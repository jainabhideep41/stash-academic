# NextAuth / Auth.js Configuration
# Generate a secret using `npx auth secret` or `openssl rand -hex 32`
AUTH_SECRET="stash_super_secret_auth_key_change_me_in_production"

# Google OAuth Credentials (obtained from Google Cloud Console)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-your-google-client-secret"

# App Base URL
NEXTAUTH_URL="http://localhost:3000"
